/**
 * Cost Meter bridge: proxy the Host's costMeter service to the mobile client.
 * Injected only when the Host provides `costMeter`; older hosts keep answering
 * `cost-meter-unavailable`, which the client degrades gracefully.
 *
 * Wire shape (mobile -> host): { type: 'cost-meter', requestId, method, args, client }
 * Wire shape (host -> mobile): { kind: 'cost-meter', requestId, method, result }
 */

export const COST_METER_REQUEST_TYPES = new Set(['cost-meter'])

const MAX_REQUEST_ID = 128
const ALLOWED_METHODS = new Set([
  'getState',
  'getStateSince',
  'updateConfig',
  'fetchPrices',
  'getRepricingHistory',
  'getPriceCatalog',
  'repriceHistory',
  'repriceModelHistory',
  'getOpenRouterCatalog',
  'releasePriceLock',
  'refreshBalance',
  'refreshGoQuota',
  'refreshGatewayQuota',
  'refreshCustomBalance',
  'refreshCodingPlan',
  'resetHistory',
  'getDaySessions',
  'getTopSessions',
  'getSessionListCosts',
  'getTurnCost',
  'getSessionCost',
  'getBillingStatistics',
  'getSessionBilling',
  'getTurnInspection',
  'getCallInspection',
  'getSessionTrajectory',
  'getContextCosts',
  'setCredential',
  'clearCredential',
])

function normalizeClient(value) {
  if (!value || typeof value !== 'object' || Array.isArray(value)) return undefined
  const version = typeof value.version === 'string' ? value.version.trim().slice(0, 64) : ''
  if (!version) return undefined
  const rawLocale = typeof value.locale === 'string' ? value.locale.trim().slice(0, 32) : ''
  const offset = Number(value.timezoneOffsetSeconds)
  return {
    version,
    locale: rawLocale || 'en',
    timezoneOffsetSeconds: Number.isFinite(offset) ? Math.trunc(offset) : 0,
  }
}

function settle(promise) {
  try { return Promise.resolve(promise).catch(() => null) } catch (_) { return Promise.resolve(null) }
}

export async function handleCostMeter(api, msg) {
  const requestId = typeof msg?.requestId === 'string' ? msg.requestId.slice(0, MAX_REQUEST_ID) : ''
  const fail = (code, message) => ({
    kind: 'error', requestType: 'cost-meter', ...(requestId ? { requestId } : {}), code, message,
  })
  if (!requestId) return fail('bad-request', 'cost-meter requires a requestId')
  const method = typeof msg?.method === 'string' ? msg.method : ''
  if (!method || !ALLOWED_METHODS.has(method)) return fail('bad-request', `unknown cost-meter method: ${method}`)
  const costMeter = api?.costMeter
  if (!costMeter || typeof costMeter[method] !== 'function') {
    return fail('cost-meter-unavailable', 'Cost meter service is unavailable on this host')
  }
  const client = normalizeClient(msg.client)
  const args = Array.isArray(msg?.args) ? msg.args : []
  try {
    const fn = costMeter[method]
    const result = client
      ? await settle(fn(...args, client))
      : await settle(fn(...args))
    return { kind: 'cost-meter', requestId, method, result: result ?? null }
  } catch (error) {
    return fail('cost-meter-unavailable', 'Cost meter operation failed')
  }
}
